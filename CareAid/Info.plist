<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Only the keys Xcode's INFOPLIST_KEY_* build settings cannot express.
  Everything else (usage descriptions, orientation, scene manifest) is still
  generated from build settings and merged into this file at build time.

  LSApplicationQueriesSchemes is what lets canOpenURL("whatsapp://") answer
  truthfully. Without it iOS always says no, the WhatsApp branch never runs,
  and a phone without WhatsApp installed would silently fall through to Safari
  instead of Messages.

  UIAppFonts registers the bundled type. These are static instances cut from
  the Nunito Sans and Inter variable fonts, one file per weight, because
  SwiftUI's .weight() modifier does not drive OpenType variation axes — a
  registered variable font only ever renders its default instance. The names
  Theme.Face refers to are the PostScript names inside these files.
-->
<plist version="1.0">
<dict>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whatsapp</string>
		<string>sms</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>NunitoSans-Regular.ttf</string>
		<string>NunitoSans-SemiBold.ttf</string>
		<string>NunitoSans-Bold.ttf</string>
		<string>NunitoSans-ExtraBold.ttf</string>
		<string>Inter-Regular.ttf</string>
		<string>Inter-Medium.ttf</string>
		<string>Inter-SemiBold.ttf</string>
		<string>Inter-Bold.ttf</string>
	</array>
</dict>
</plist>
